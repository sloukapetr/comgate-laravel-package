{
  "name": "sloukapetr/comgate-laravel-package",
  "description": "Laravel package for Comgate Merchant REST API and Status API integration.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "comgate",
    "payments",
    "gateway",
    "refunds",
    "subscriptions"
  ],
  "homepage": "https://github.com/sloukapetr/comgate-laravel-package",
  "support": {
    "issues": "https://github.com/sloukapetr/comgate-laravel-package/issues",
    "source": "https://github.com/sloukapetr/comgate-laravel-package"
  },
  "require": {
    "php": "^8.2",
    "illuminate/events": "^11.0|^12.0|^13.0",
    "illuminate/http": "^11.0|^12.0|^13.0",
    "illuminate/routing": "^11.0|^12.0|^13.0",
    "illuminate/support": "^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0|^11.0"
  },
  "autoload": {
    "psr-4": {
      "Sloukapetr\\ComgateLaravelPackage\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Sloukapetr\\ComgateLaravelPackage\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Sloukapetr\\ComgateLaravelPackage\\ComgateServiceProvider"
      ],
      "aliases": {
        "Comgate": "Sloukapetr\\ComgateLaravelPackage\\Facades\\Comgate"
      }
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
